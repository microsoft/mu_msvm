## @file
#  EFI Diagnostics DXE driver.
#
#  Registers callbacks that tell the host VMM to process the AdvancedLogger
#  buffer at ExitBootServices and on ResetSystem(). Publishing the buffer's
#  GPA to the host is handled by MsvmPkg/EfiDiagnosticsPei in PEI.
#
#  Copyright (c) Microsoft Corporation.
#  SPDX-License-Identifier: BSD-2-Clause-Patent
##

[Defines]
  INF_VERSION         = 0x00010017
  BASE_NAME           = EfiDiagnosticsDxe
  FILE_GUID           = ED1F52CC-1AC3-4365-A719-32BAC74A3EEE
  VERSION_STRING      = 1.0
  MODULE_TYPE         = DXE_DRIVER
  ENTRY_POINT         = EfiDiagnosticsDxeEntry

[Sources]
  EfiDiagnosticsDxe.c

[LibraryClasses]
  BaseLib
  DebugLib
  EfiDiagnosticsLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint
  UefiLib

[Packages]
  MsvmPkg/MsvmPkg.dec
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec

[Guids]
  gEfiEventBeforeExitBootServicesGuid                     ## CONSUMES
  gEfiEventExitBootServicesGuid                           ## CONSUMES
  gEfiEventReadyToBootGuid                                ## CONSUMES
  gMsvmUnableToBootEventGuid                              ## CONSUMES

[Protocols]
  gEfiResetNotificationProtocolGuid                       ## CONSUMES

[Depex]
  TRUE
